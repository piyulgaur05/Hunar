{
  "name": "hunare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @mitti/database generate",
    "db:migrate": "pnpm --filter @mitti/database migrate",
    "db:seed": "pnpm --filter @mitti/database seed",
    "infra:up": "docker compose up -d postgres redis minio mailpit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "vitest": "^3.2.0",
    "eslint": "^9.30.0",
    "typescript-eslint": "^8.35.0",
    "prettier": "^3.6.0",
    "dotenv-cli": "^8.0.0"
  }
}
